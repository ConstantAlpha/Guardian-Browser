{
  "manifest_version": 3,
  "name": "Focus & Content Shield",
  "version": "2.0",
  "description": "Block ads, adult content, gambling, and distracting sites.",
  "permissions": [
    "storage",
    "tabs",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_width": 320,
    "default_height": 450
  },
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads_rules",
        "enabled": true,
        "path": "rules/ads.json"
      },
      {
        "id": "adult_rules",
        "enabled": true,
        "path": "rules/adult.json"
      },
      {
        "id": "gambling_rules",
        "enabled": true,
        "path": "rules/gambling.json"
      }
    ]
  }
}
