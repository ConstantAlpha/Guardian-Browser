{
  "manifest_version": 3,
  "name": "Guardian Extension",
  "version": "1.0",
  "description": "Blocks adult and ad domains across all tabs.",
  "permissions": ["declarativeNetRequest", "declarativeNetRequestFeedback"],
  "host_permissions": ["<all_urls>"],
  "declarative_net_request": {
    "rule_resources": [{
      "id": "blocklist",
      "enabled": true,
      "path": "rules.json"
    }]
  }
}
